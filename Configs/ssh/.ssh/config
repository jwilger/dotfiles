Host hydrogen.slipstreamconsulting.net
  User admin

Host *
  ForwardAgent yes
  AddKeysToAgent no
  Compression yes
  ServerAliveInterval 0
  ServerAliveCountMax 3
  HashKnownHosts no
  UserKnownHostsFile ~/.ssh/known_hosts
  ControlMaster yes
  ControlPath ~/.ssh/master-%r@%n:%p
  ControlPersist no

  
